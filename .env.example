# Amazon SP-API 認証情報
# このファイルをコピーして .env ファイルを作成し、実際の値を入力してください

API_KEY=amzn1.application-oa2-client.xxxxx
API_SECRET=amzn1.oa2-cs.v1.xxxxx
REFRESH_TOKEN=Atzr|xxxxx

# Google Sheets設定
SHEET_ID=your_sheet_id_here
SELLER_ID=your_seller_id_here

# === Python版 リアルタイム売上モニタリング ===
# Amazon SP-API (python-amazon-sp-api用)
SP_API_REFRESH_TOKEN=your_refresh_token
LWA_APP_ID=your_lwa_app_id
LWA_CLIENT_SECRET=your_lwa_client_secret
SP_API_ACCESS_KEY=your_aws_access_key
SP_API_SECRET_KEY=your_aws_secret_key
SP_API_ROLE_ARN=your_role_arn

# Google Sheets (サービスアカウント認証)
GOOGLE_CREDENTIALS_FILE=service_account.json

# リアルタイム売上シート
SPREADSHEET_ID=1Z3P0iL19r3gA9-NG8x2e_42pGhrEs_wFMLWLbFvReAw
SHEET_NAME=売上/今
